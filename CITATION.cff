    given-names: "Anne Cathrine"
    affiliation: "Technical University of Denmark (DTU)"
license: MIT
repository-code: "https://github.com/annecathrinel/policy-corpus-builder"
url: "https://github.com/annecathrinel/policy-corpus-builder"
version: 0.1.0
date-released: "2026-07-23"
keywords:
